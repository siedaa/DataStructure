#include<iostream>
using namespace std;

class maxHeap {
    int *arr;
    int size ;
    int total_size;
public:

maxHeap (int n ) {
    arr= new int [n];
    size =0;
    total_size = n;
}

    void insertion (int value) {
        if (size== total_size) {
            cout<<"Heap is full"<<endl;
            return;
        }

        arr[size] = value;
        int index = size;
        size++;

        while (index >0 && arr[(index-1)/2] < arr[index]) {
            swap(arr[index] , arr[(index-1)/2]);
            index = (index-1)/2;

        }
        cout<<"Inserted patient"<<arr[index] <<endl;
    }


void print() {
    for (int i=0;i<size;i++) {
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

void heapify (int index) {
    int largest= index ;
    int left =  2*index +1;
    int right =  2*index+2;

    if (left<size && arr[left]> arr[index]) {
        largest = left;
    } 
    if (right <size && arr[right]> arr[index]){
        largest = right;
    }

    if (largest != index) {
        swap (arr[index] , arr[largest]);
        heapify (largest);
    }
}
void remove () {
    if (size==0) {
        cout<<"Heap is empty"<<endl;
        return;
    }
    cout<<"patient treated" <<endl;
    arr[0]= arr[size-1];
    size--;

    if (size ==0) {
        return ;
    }

    heapify (0);
}
};

int main () {
    maxHeap h(5);
    
    h.insertion(5);
    h.insertion(6);
    h.insertion(3);
    h.insertion(8);
    h.print();
    h.insertion(10);
    cout<<"heap updates after adding 10"<<endl;
    h.print();
    h.remove();
    return 0;
}

