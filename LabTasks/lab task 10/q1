#include<iostream>
using namespace std;

class minHeap {
    int *arr;
    int size ;
    int total_size;
public:

minHeap (int n ) {
    arr= new int [n];
    size =0;
    total_size = n;
}

    void insertion (int value) {
        if (size== total_size) {
            cout<<"Heap is full"<<endl;
            return;
        }

        arr[size] = value;
        int index = size;
        size++;

        while (index >0 && arr[(index-1)/2] > arr[index]) {
            swap(arr[index] , arr[(index-1)/2]);
            index = (index-1)/2;

        }
        cout<<"Inserted package"<<arr[index] <<endl;
    }


void print() {
    for (int i=0;i<size;i++) {
        cout<<arr[i]<<" ";
    }
}
};

int main () {
    minHeap h(5);
    h.insertion(10);
    h.insertion(5);
    h.insertion(20);
    h.insertion(3);
    h.insertion(8);
    h.print();
    return 0;
}

