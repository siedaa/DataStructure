#include <iostream>
#include <string>
using namespace std;

// Node for linked list
class Node {
public:
    string data;
    Node* next;

    Node(string value) {
        data = value;
        next = NULL;
    }
};

// Hash table with chaining
class HashTable {
    Node** table;   // array of linked-list heads
    int bucketCount;

public:
    HashTable(int n) {
        bucketCount = n;
        table = new Node*[bucketCount];

        for (int i = 0; i < bucketCount; i++) {
            table[i] = NULL;
        }
    }

    // Hash function: sum of ASCII values % bucket count
    int hashFunction(string key) {
        int sum = 0;
        for (char c : key)
            sum += int(c);
        return sum % bucketCount;
    }

    // Insert a string into the hash table
    void insert(string key) {
        int index = hashFunction(key);

        Node* newNode = new Node(key);

        // Insert at head (for simplicity)
        newNode->next = table[index];
        table[index] = newNode;

        cout << "Inserted: " << key << " at bucket " << index << endl;
    }

    // Display hash table
    void display() {
        cout << "\n--- Hash Table ---\n";
        for (int i = 0; i < bucketCount; i++) {
            cout << i << " --> ";
            Node* temp = table[i];

            if (!temp) {
                cout << "NULL";
            } else {
                while (temp) {
                    cout << temp->data << " -> ";
                    temp = temp->next;
                }
                cout << "NULL";
            }
            cout << endl;
        }
    }
};

// Main
int main() {
    HashTable ht(5); // 5 buckets

    ht.insert("apple");
    ht.insert("banana");
    ht.insert("cat");
    ht.insert("dog");
    ht.insert("apple");  // duplicate allowed
    ht.insert("mango");

    ht.display();

    return 0;
}
